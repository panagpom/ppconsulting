---
import type {RenderContext} from '../../lib/render-context';
import type {LocalizedContent,LocalizedSection} from '../../../../../packages/content/types';
import Icon from './Icon.astro';
import Heading from './Heading.astro';import Action from './Action.astro';import Background from './Background.astro';import ServiceGroups from './ServiceGroups.astro';import ArticleCards from './ArticleCards.astro';
interface Props {context:RenderContext;content:LocalizedContent;section:LocalizedSection;pageId:string;primary?:boolean}
const {context,content,section:s,pageId,primary=false}=Astro.props;const c:any=s.copy;const hero=s._template==='hero',home=pageId==='home';const a=s.appearance;const actions=c.actions?.length?c.actions:c.link&&hero?[{...c.link,icon:'conversation'}]:[];const rich=(v:string,inline=false)=>context.rich(v??'',content.locale,inline);
---
<div data-section-color-scheme={a.colorScheme??'auto'} data-page-id={pageId} data-page-section={s.id} data-section-appearance={hero?'hero':s.id} class:list={[hero?'home-hero-band':'home-section-band',hero&&home&&'home-hero-band--boundary-actions',a.surface==='muted'&&'home-section-band--muted',a.imageEnabled&&a.backgroundImage&&!hero&&'home-section-band--photographic',s.id==='perspective'&&'home-section-band--perspective']}>
{!hero&&<Background src={a.backgroundImage} enabled={a.imageEnabled} pageId={pageId} sectionId={s.id}/>}
{hero?<><section class:list={['hero','wrap','ds-hero','ds-hero--editorial',!home&&'advisory-page-hero']}><div class="ds-hero-copy">{c.eyebrow&&<p class="eyebrow" set:html={rich(c.eyebrow,true)}/>}<Heading text={c.title} level={primary?'h1':'h2'} variant="display" accentLastLine class="ds-hero-title"/><div class="intro description" set:html={rich(c.description,true)}/></div><div class="ds-hero-media"><Background src={a.backgroundImage} enabled={a.imageEnabled} hero pageId={pageId} sectionId={s.id}/></div></section>{actions.length>0&&<div class="hero-actions home-hero-actions wrap">{actions.map((act:any,i:number)=><Action href={context.link(act.href,content.locale)} size="large" variant={i?'inverse':'primary'} trailingIcon={act.icon??'conversation'}>{act.label}</Action>)}</div>}</>:<section id={s.id} class:list={['section','wrap','ds-section','ds-section--editorial',s.id==='perspective'&&'editorial-perspective',s._template==='steps'&&'axia-approach']}>
{s.id==='perspective'?<>{c.eyebrow&&<div class="section-heading"><div><p class="eyebrow" set:html={rich(c.eyebrow,true)}/></div></div>}<div class="editorial-statement" data-motion-reveal><Heading text={c.title} accentLastLine/><div class="description" set:html={rich(c.body)}/></div></>:<><header class="section-heading" data-motion-reveal><div>{c.eyebrow&&<p class="eyebrow" set:html={rich(c.eyebrow,true)}/>}<Heading text={c.title} accentLastLine/>{c.description&&s._template!=='offering-list'&&<div class="description ds-section-description" set:html={rich(c.description,true)}/>}</div>{s._template==='article-list'&&c.link&&<Action variant="quiet" href={context.link(c.link.href,content.locale)} trailingIcon="article">{c.link.label}</Action>}</header>
{s._template==='rich-text'&&<div class="reading" data-motion-reveal set:html={rich(c.body)}/>}
{s._template==='offering-list'&&<ServiceGroups content={content} context={context} sectionId={s.id}/>}
{s._template==='article-list'&&<ArticleCards content={content} context={context} pageId={pageId} sectionId={s.id}/>}
{s._template==='steps'&&<ol class="axia-steps">{c.items.map((item:any,i:number)=><li><article class="ds-card ds-card--editorial" data-motion-reveal><p class="eyebrow">{String(i+1).padStart(2,'0')} /</p><h3 class="ds-card-title">{item.title}</h3><div class="description" set:html={rich(item.body)}/></article></li>)}</ol>}{s._template==='steps'&&c.link&&<Action href={context.link(c.link.href,content.locale)} variant="quiet" trailingIcon="people">{c.link.label}</Action>}
{s._template==='faq'&&<><div class="ds-faq">{c.items.map((item:any)=><details data-motion-reveal><summary><span class="ds-faq-question">{item.question}</span><span class="ds-faq-toggle" aria-hidden="true"><Icon name="plus"/></span></summary><div class="description" set:html={rich(item.answer)}/></details>)}</div>{c.link&&<aside class="faq-contact"><h3 class="faq-contact-title">{c.contactTitle}</h3><Action href={context.link(c.link.href,content.locale)} size="large" trailingIcon="conversation">{c.link.label}</Action></aside>}</>}
{s._template==='cta'&&c.link&&<Action href={context.link(c.link.href,content.locale)} size="large" trailingIcon="conversation">{c.link.label}</Action>}
{s._template==='people-list'&&<div class="cards">{content.people.map(p=><article class="ds-card ds-card--editorial"><h3><a href={context.link('/people/'+p.slug,content.locale)}>{p.title}</a></h3><p>{p.role}</p><div set:html={rich(p.description,true)}/></article>)}</div>}
</>}
</section>}
</div>
