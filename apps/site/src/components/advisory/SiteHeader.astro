---
import Icon from './Icon.astro';import LinkLabel from './LinkLabel.astro';import ContactDetails from '../ui/ContactDetails.astro';import SocialLinks from '../ui/SocialLinks.astro';
import {contactChannels} from '../../../../../packages/content/contact.mjs';
import type {LocalizedContent,Alternate} from '../../../../../packages/content/types';import type {RenderContext} from '../../lib/render-context';
interface Props {content:LocalizedContent;context:RenderContext;alternates:Alternate[];path:string}
const {content,context,alternates,path}=Astro.props;const el=content.locale==='el';const channels=contactChannels(content.settings,content.locale);if(context.previewBase){channels.social=[];channels.direct=channels.direct.map(i=>({...i,href:'#'}));}
const homePage=content.pages.find(p=>p._template==='home');
const orbit=homePage?.sections.find(s=>s._template==='offering-list'&&s.variant==='orbit');
const items=content.settings.navigation.map(n=>({...n,path:content.pages.find(p=>p.contentId===n.pageId)!.path}));const home=content.pages.find(p=>p._template==='home')!.path;
---
<div class="header-shell"><header class="site-header wrap"><a class="brand" href={context.link(home,content.locale)} aria-label={content.settings.brand.name+' — '+(el?'Αρχική':'Home')}><span class="brand-mark"><Icon name="mark"/></span><LinkLabel>{content.settings.brand.name}</LinkLabel><span class="brand-dot">.</span></a><nav class="header-fallback" data-navigation-fallback aria-label={el?'Κύρια πλοήγηση':'Main navigation'}>{items.map(i=><a href={i.pageId==='services'&&path===home&&orbit?'#'+orbit.id:context.link(i.path,content.locale)} aria-current={i.path===path?'page':undefined}>{i.label}</a>)}</nav><div class="header-actions">{content.settings.social.showInHeader&&<SocialLinks links={channels.social} locale={content.locale} variant="icons" placement="header"/>}<nav class="language-switcher language-switcher--segmented" aria-label={el?'Γλώσσα':'Language'}>{alternates.map(a=><a href={context.link(a.path,a.locale)} lang={a.locale} hreflang={a.locale} aria-label={context.project.languages.find(l=>l.code===a.locale)?.label} aria-current={a.locale===content.locale?'page':undefined}>{a.locale.toUpperCase()}</a>)}</nav><button class="menu-toggle" type="button" data-menu-open hidden aria-label={el?'Άνοιγμα μενού':'Open menu'} aria-haspopup="dialog" aria-controls="site-menu" aria-expanded="false"><span class="menu-lines" aria-hidden="true"><span class="menu-line"></span><span class="menu-line"></span><span class="menu-line"></span></span></button></div></header></div>
<dialog id="site-menu" class="site-menu" aria-labelledby="menu-title"><div class="menu-inner wrap"><div class="menu-top"><h2 id="menu-title" class="eyebrow">{el?'Μενού':'Menu'}</h2><button class="menu-close" type="button" data-menu-close autofocus aria-label={el?'Κλείσιμο μενού':'Close menu'}><span class="menu-lines" aria-hidden="true"><span class="menu-line"></span><span class="menu-line"></span><span class="menu-line"></span></span></button></div><div class="menu-grid"><nav class="menu-primary" aria-label={el?'Κύρια πλοήγηση':'Main navigation'}>{items.map((i,index)=><a href={i.pageId==='services'&&path===home&&orbit?'#'+orbit.id:context.link(i.path,content.locale)} aria-current={i.path===path?'page':undefined}><span class="menu-number" aria-hidden="true">{String(index+1).padStart(2,'0')}</span><LinkLabel>{i.label}</LinkLabel></a>)}</nav><aside class="menu-aside"><div class="menu-contact"><h3 class="menu-contact-title">{el?'Επικοινωνία':'Get in touch'}</h3><ContactDetails channels={channels} locale={content.locale}/></div><SocialLinks links={channels.social} locale={content.locale} variant="icons"/><div class="menu-language"><nav class="language-switcher language-switcher--segmented" aria-label={el?'Γλώσσα':'Language'}>{alternates.map(a=><a href={context.link(a.path,a.locale)} lang={a.locale} hreflang={a.locale} aria-current={a.locale===content.locale?'page':undefined}>{a.locale.toUpperCase()}</a>)}</nav></div></aside></div></div></dialog>
<script src="../../scripts/navigation.ts"></script>
