---
import {deploymentIdentity,identityText} from '../../../../packages/config/deployment-identity.mjs';
import '../styles/foundations.css';
import '../styles/themes.generated.css';
import '../styles/global.css';
import '../styles/motion.css';
import '../styles/newsletter.css';
import NewsletterFooter from '../components/newsletter/NewsletterFooter.astro';
import VisitorDialogs from '../components/newsletter/VisitorDialogs.astro';
import {resolveNewsletterExperience} from '../../../../packages/content/newsletter.mjs';
import {newsletterMessages} from '../scripts/newsletter-messages';
import '../styles/advisory/lato.css';
import '@fontsource/merriweather/400.css';
import '@fontsource/merriweather/600.css';
import '@fontsource/merriweather/700.css';
import '@fontsource/merriweather/400-italic.css';
import '../styles/advisory/foundations.css';
import '../styles/advisory/components.css';
import '../styles/advisory/global.css';
import '../styles/advisory/axia.css';
import '../styles/advisory/bridge.css';
import '../styles/advisory/light-home.css';
import '../styles/advisory/light-interior.css';
import AccessibilityControls from '../components/accessibility/Controls.astro';
import '../styles/accessibility.css';
import SiteHeader from '../components/advisory/SiteHeader.astro';
import ContactDetails from '../components/ui/ContactDetails.astro';
import SocialLinks from '../components/ui/SocialLinks.astro';
import BrandLogo from '../components/advisory/BrandLogo.astro';
import {contactChannels} from '../../../../packages/content/contact.mjs';
import RichText from '../components/ui/RichText.astro';
import {renderContext as defaultContext} from '../lib/content';
import type {RenderContext} from '../lib/render-context';
import type {LocalizedContent,Alternate} from '../../../../packages/content/types';
interface Props {context?:RenderContext;content:LocalizedContent;title:string;description:string;path:string;alternates:Alternate[];noindex?:boolean}
const {content,title,description,path,alternates,noindex=false,context=defaultContext}=Astro.props;const project=context.project;const preview=Boolean(context.previewBase);const {settings,locale}=content;const href=(value:string|undefined)=>value?context.link(value,locale):undefined;const el=locale==='el';const channels=contactChannels(settings,locale);if(preview){channels.social=[];channels.direct=channels.direct.map(item=>({...item,href:'#'}));}
const currentPage=content.pages.find(page=>page.path===path);
const experience=preview?null:resolveNewsletterExperience(settings,project,{locale,privacyHref:content.pages.find(page=>page.contentId==='privacy')?.path??null,pageKind:noindex?'system':currentPage?.contentId==='privacy'?'privacy':currentPage?._template??'editorial',localProtectionAvailable:project.environment==='local'});
const contactHref=content.pages.find(page=>page._template==='contact')?.path??`/${locale}/contact`;const visitorMessages=newsletterMessages(locale);
---
<!doctype html><html data-eyebrow-treatment={project.design.eyebrows?.treatment??'soft-highlight'} data-motion={project.design.motion.enabled?'on':'off'} lang={locale} data-theme={project.design.theme} data-density={project.design.density}><head><meta charset="UTF-8"/><link rel="stylesheet" href="/presentation.css"/>{!preview&&deploymentIdentity(project)&&<meta name="starter-deployment" content={identityText(deploymentIdentity(project))}/>}<meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | {settings.brand.name}</title><meta name="description" content={description}/>{!preview&&<link rel="canonical" href={new URL(path,project.siteUrl).href}/>}{(noindex||preview)&&<meta name="robots" content="noindex"/>}{!preview&&alternates.map(a=><link rel="alternate" hreflang={a.locale} href={project.siteUrl+a.path}/>)}{!preview&&content.feedPath&&<link rel="alternate" type="application/rss+xml" title={settings.brand.name} href={content.feedPath}/>}</head><body>{preview&&<aside class="template-preview-notice"><a href="/templates">{el?'Πίσω στα πρότυπα':'Back to templates'}</a><span>{el?'Προεπισκόπηση — οι φόρμες είναι ανενεργές':'Template preview — forms are disabled'}</span></aside>}
<a class="skip" href="#main">{el?'Μετάβαση στο περιεχόμενο':'Skip to content'}</a>
<SiteHeader content={content} context={context} alternates={alternates} path={path}/>
<main id="main" class:list={[!preview&&currentPage?._template!=='home'&&'light-interior']}><slot/></main>
<footer class="site-footer wrap">
  <div class="footer-brand">
    <a class="brand" href={href(content.pages.find(p=>p._template==='home')?.path)}><BrandLogo brand={settings.brand}>{settings.brand.name}</BrandLogo></a>
    <div class="footer-identity">
      <p class="footer-tagline">{settings.brand.tagline}</p>
      {settings.legal.businessName!==settings.brand.name&&<p class="footer-legal-name">{settings.legal.businessName}</p>}
      {settings.legal.notice.trim()&&<RichText context={context} body={settings.legal.notice} locale={locale}/>}
    </div>
  </div>
  <div class="footer-contact">
    <h2 class="footer-heading">{el?'Επικοινωνία':'Get in touch'}</h2>
    <ContactDetails channels={channels} locale={locale}/>
    <SocialLinks links={channels.social} locale={locale} variant="icons" placement="footer"/>
  </div>
  <div class="footer-navigation">
    <h2 class="footer-heading" id="footer-navigation-title">{el?'Εξερευνήστε':'Explore'}</h2>
    <nav aria-labelledby="footer-navigation-title">
      {settings.navigation.map(n=><a href={href(content.pages.find(p=>p.contentId===n.pageId)!.path)}>{n.label}</a>)}
    </nav>
  </div>
  <div class="footer-bottom">
    <small>© {new Date().getUTCFullYear()} {settings.brand.name}</small>
    <div class="footer-utility">
      <a href={href(content.pages.find(p=>p.contentId==='privacy')?.path)}>{el?'Απόρρητο':'Privacy'}</a>
      {experience&&<div class:list={['footer-experience',experience.footerMode==='inline'&&'footer-experience--inline']} data-visitor-experience={experience.canSubmit?true:undefined} data-protection-mode={experience.protection.mode} data-project={project.name} data-interest={experience.interest} data-delay-seconds={experience.delaySeconds} data-dismiss-days={experience.dismissDays} data-accepted-days={experience.acceptedDays} data-auto-eligible={String(experience.autoEligible)}>
        <NewsletterFooter model={experience} locale={locale} contactHref={contactHref}/>
        {experience.canSubmit&&experience.preferences&&<button type="button" class="visitor-preferences-button" data-preferences-open data-preferences-open-footer hidden>{visitorMessages.preferences}</button>}
        <VisitorDialogs model={experience} locale={locale}/>
      </div>}
    </div>
  </div>
</footer>
{!preview&&settings.accessibility?.enabled&&<AccessibilityControls locale={locale} projectName={project.name} settings={settings.accessibility}/>}
<script src="../scripts/site-entry.ts"></script></body></html>
