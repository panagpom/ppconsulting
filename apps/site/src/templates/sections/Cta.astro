---
import type {RenderContext} from '../../lib/render-context';
import {renderContext as defaultContext} from '../../lib/content';
import Description from '../../components/ui/Description.astro';
import Heading from '../../components/advisory/Heading.astro';
import Action from '../../components/advisory/Action.astro';
import type {LocalizedSection} from '../../../../../packages/content/types';
interface Props {context?:RenderContext;section:Extract<LocalizedSection,{_template:'cta'}>;locale:string}
const {section,locale,context=defaultContext}=Astro.props;
---
<section class="light-closing" id={section.id} data-surface={section.appearance.surface} aria-label={section.copy.title.replaceAll('\n',' ')}><div class="wrap" data-motion-reveal><Heading text={section.copy.title}/>{section.copy.description&&<Description context={context} text={section.copy.description} locale={locale}/>}<Action href={context.link(section.copy.link.href,locale)} trailingIcon="arrow-right">{section.copy.link.label}</Action></div></section>
