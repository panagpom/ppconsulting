---
import type {RenderContext} from '../lib/render-context';
import {renderContext as defaultContext} from '../lib/content';
import EnquiryAction from '../components/advisory/EnquiryAction.astro';
import Background from '../components/advisory/Background.astro';
import Heading from '../components/advisory/Heading.astro';
import Icon from '../components/advisory/Icon.astro';
import RichText from '../components/ui/RichText.astro';
import Description from '../components/ui/Description.astro';
import SectionImage from '../components/ui/SectionImage.astro';
import {resolveSectionMedia} from '../lib/section-media';
import Cta from './sections/Cta.astro';
import type {LocalizedArticle,LocalizedContent,LocalizedOffering,LocalizedPerson} from '../../../../packages/content/types';
interface Props {context?:RenderContext;record:LocalizedArticle|LocalizedOffering|LocalizedPerson;content:LocalizedContent}
const {record,content,context=defaultContext}=Astro.props;
const {locale}=content;
const el=locale==='el';
const offering='audience' in record?record:undefined;
const offeringsPage=offering?context.routes.find(route=>route.kind==='page'&&route.contentId==='services'&&route.locale===locale):undefined;
const home=offering?content.pages.find(page=>page._template==='home'):undefined;
const homeClosing=home?.sections.find(section=>section.id==='closing');
const configuredClosing=homeClosing?._template==='cta'?homeClosing:undefined;
const closingTitle=el?'Σκέφτεστε το επόμενο βήμα\nγια την επιχείρησή σας;':'Thinking about your next step?';
const closingLabel=el?'Επικοινωνήστε μαζί μας':'Contact us';
const offeringClosing=offering?{
  id:'offering-contact',_template:'cta' as const,enabled:true,variant:'default' as const,
  appearance:configuredClosing?.appearance??{surface:'muted' as const},
  copy:{
    title:configuredClosing?.copy.title??closingTitle,
    description:configuredClosing?.copy.description??'',
    link:{label:configuredClosing?.copy.link.label??closingLabel,href:'/contact?contextId='+encodeURIComponent(offering.contentId)},
  },
}:undefined;
const offeringBody=offering?context.rich(offering.body,locale):'';
const lead=offering?.description?`<p>${context.rich(offering.description,locale,true)}</p>\n`:'';
const serviceBody=lead&&offeringBody.startsWith(lead)?offeringBody.slice(lead.length):offeringBody;
const article='category' in record?record:undefined;
const media=article?.image?await resolveSectionMedia(article.image,{pageId:article.contentId,sectionId:'article'}):undefined;
---
{offering&&offeringClosing?<article class="offering-detail">
  <header class="offering-intro">
    <div class="wrap offering-intro-layout">
      <div>
        {offeringsPage&&<a class="offering-back" href={context.link(offeringsPage.path,locale)}><span aria-hidden="true">←</span> {el?'Όλες οι υπηρεσίες':'All services'}</a>}
        <Heading text={offering.title} level="h1" accentLastLine variant="display"/>
        <Description context={context} text={offering.description} locale={locale}/>
      </div>
      <div class="offering-emblem" aria-hidden="true"><span><Icon name={offering.audience==='individual'?'user':'briefcase'}/></span></div>
    </div>
  </header>
  {serviceBody.trim()&&<div class="wrap offering-content"><div class="prose offering-reading" set:html={serviceBody}/></div>}
  <div class:list={['default-section-band','home-section-band','offering-closing',offeringClosing.appearance.imageEnabled&&'home-section-band--photographic']} data-page-id={home?.contentId} data-page-section={configuredClosing?.id} data-section-color-scheme={offeringClosing.appearance.colorScheme??'auto'}>
    <Background src={offeringClosing.appearance.backgroundImage} enabled={offeringClosing.appearance.imageEnabled} pageId={home?.contentId??offering.contentId} sectionId={configuredClosing?.id??offeringClosing.id}/>
    <Cta section={offeringClosing} context={context} locale={locale}/>
  </div>
</article>:<><article class="interior-detail">
  <div class="interior-detail-intro">
    <div class="wrap">
      {('role' in record||article?.category||record.publishAt)&&<p class="interior-detail-meta">
        {'role' in record?<span>{record.role}</span>:article?.category&&<span>{article.category}</span>}
        {record.publishAt&&<time datetime={record.publishAt}>{new Date(record.publishAt).toLocaleDateString(content.locale,{dateStyle:'long',timeZone:'UTC'})}</time>}
      </p>}
      <Heading text={record.title} level="h1" accentLastLine variant="display"/>
      <Description context={context} text={record.description} locale={content.locale}/>
    </div>
  </div>
  <div class="wrap interior-detail-body">
    {media&&article?.image&&<div class:list={['interior-detail-photo', article.imagePosition==='right center'&&'image-position-right',article.imagePosition==='left center'&&'image-position-left']}>
      <SectionImage context={context} media={media} layout="room-detail" alt={article.imageAlt??''} crop={article.image.crop} ratio="landscape" locale={content.locale}/>
    </div>}
    <RichText context={context} body={record.body} locale={content.locale}/>
  </div>
</article>
<div class="interior-enquiry"><EnquiryAction context={context} locale={locale} contextId={'role' in record?undefined:article?.offeringId??record.contentId}/></div></>}
