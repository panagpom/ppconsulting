---
import type {RenderContext} from '../lib/render-context';
import {renderContext as defaultContext} from '../lib/content';
import EnquiryAction from '../components/advisory/EnquiryAction.astro';
import Heading from '../components/advisory/Heading.astro';
import RichText from '../components/ui/RichText.astro';
import Description from '../components/ui/Description.astro';
import type {LocalizedContent} from '../../../../packages/content/types';
interface Props {context?:RenderContext;record:{title:string;contentId?:string;offeringId?:string;role?:string;publishAt?:string;description:string;body:string};content:Pick<LocalizedContent,'locale'>}
const {record,content,context=defaultContext}=Astro.props;
---
<article class="wrap editorial reading-page"><Heading text={record.title} level="h1" accentLastLine variant="display"/><div class="reading">{'role' in record&&<p>{record.role}</p>}{'publishAt' in record&&record.publishAt&&<p><time datetime={record.publishAt}>{new Date(record.publishAt).toLocaleDateString(content.locale,{dateStyle:'long',timeZone:'UTC'})}</time></p>}<Description context={context} text={record.description} locale={content.locale}/><RichText context={context} body={record.body} locale={content.locale}/></div></article><EnquiryAction context={context} locale={content.locale} contextId={'role' in record?undefined:record.offeringId??record.contentId}/>
